                                    <th style="width:18%">Version</th>
                                    <th style="width:18%">Release Date</th>
                                    <th style="width:32%">Download</th>
                                </tr>
                                <tr>
                                    <td colspan="4">
                                        <hr>
                                    </td>
                                </tr>
                                <tr style="text-align:center">
                                    <td><a href="https://stella-emu.github.io" title="Stella homepage"
                                            class="external">Stella</a></td>
                                    <td>7.0c<br><br>7.0</td>
                                    <td>Jan 02, 2025<br><br>Oct 04, 2024</td>
                                    <td><input type="image" src="/images/icons/windows.svg" width="32" height="32"
                                            onClick="this.form.elements['id'].value=52"
                                            title="Download Stella for Windows (3.32 MB)" alt="Download"><br><input
                                            type="image" src="/images/icons/mac.svg" width="32" height="32"
                                            onClick="this.form.elements['id'].value=53"
                                            title="Download Stella for Mac (10.07 MB)" alt="Download"></td>
                                </tr>
                            </table>
